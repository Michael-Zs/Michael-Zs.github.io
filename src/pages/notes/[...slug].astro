---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const notes = await getCollection("notes");

	return notes.map((note) => ({
		params: {
			slug: note.id,
		},
		props: {
			note,
		},
	}));
}

const { note } = Astro.props;

const { Content } = await render(note);

const pubDate = note.data.pubDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{note.data.title} · Michael</title>
		<meta name="description" content={note.data.description} />
	</head>

	<body>
		<header>
			<a href="/" class="logo">Michael</a>
		</header>

		<main>
			<article class="note">
				<p class="meta">
					<time datetime={note.data.pubDate.toISOString()}>
						{pubDate}
					</time>
				</p>

				<h1>{note.data.title}</h1>

				{
					note.data.tags.length > 0 && (
						<ul class="tags">
							{note.data.tags.map((tag) => (
								<li>#{tag}</li>
							))}
						</ul>
					)
				}

				<div class="content">
					<Content />
				</div>

				<p class="back">
					<a href="/">← Home</a>
				</p>
			</article>
		</main>

		<footer>
			<p>© 2026 Michael</p>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family:
			-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #222;
		background: #fafafa;
	}

	header {
		max-width: 1000px;
		margin: 0 auto;
		padding: 28px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		font-weight: 700;
		font-size: 18px;
		color: inherit;
		text-decoration: none;
	}

	main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 40px 24px 80px;
	}

	.note {
		max-width: 680px;
	}

	.meta {
		font-size: 14px;
		color: #888;
		margin: 0 0 12px;
	}

	h1 {
		font-size: clamp(32px, 5vw, 44px);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 12px;
	}

	.tags {
		display: flex;
		gap: 12px;
		list-style: none;
		margin: 0 0 32px;
		padding: 0;
	}

	.tags li {
		font-size: 13px;
		color: #888;
	}

	.content {
		line-height: 1.75;
		overflow-wrap: break-word;
	}

	.content :global(h2) {
		font-size: 24px;
		letter-spacing: -0.01em;
		margin: 40px 0 12px;
	}

	.content :global(h3) {
		font-size: 19px;
		margin: 32px 0 10px;
	}

	.content :global(p) {
		margin: 0 0 20px;
	}

	.content :global(ul),
	.content :global(ol) {
		margin: 0 0 20px;
		padding-left: 24px;
	}

	.content :global(li) {
		margin-bottom: 6px;
	}

	.content :global(a) {
		color: #111;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.content :global(img) {
		display: block;
		max-width: min(100%, 480px);
		height: auto;
		margin: 0 auto 24px;
		border-radius: 6px;
	}

	.content :global(blockquote) {
		margin: 0 0 20px;
		padding: 4px 20px;
		border-left: 3px solid #ddd;
		color: #666;
	}

	.content :global(code) {
		font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
		font-size: 0.88em;
		background: #eee;
		border-radius: 4px;
		padding: 2px 6px;
		overflow-wrap: anywhere;
	}

	.content :global(pre) {
		border-radius: 8px;
		padding: 20px;
		max-width: 100%;
		overflow-x: auto;
		font-size: 14px;
		line-height: 1.6;
	}

	.content :global(pre code) {
		background: none;
		padding: 0;
		font-size: 1em;
		overflow-wrap: normal;
	}

	.content :global(table) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}

	.back {
		margin-top: 48px;
		border-top: 1px solid #ddd;
		padding-top: 24px;
	}

	.back a {
		color: #666;
		text-decoration: none;
		font-size: 14px;
	}

	.back a:hover {
		color: #111;
	}

	footer {
		max-width: 1000px;
		margin: 0 auto;
		padding: 40px 24px;
		color: #999;
		font-size: 13px;
	}
</style>
