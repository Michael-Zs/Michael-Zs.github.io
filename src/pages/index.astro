---
import { getCollection } from "astro:content";

const title = "Michael";
const description = "Notes, research, and things I build.";

const notes = (await getCollection("notes")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>

	<body>
		<header>
			<a href="/" class="logo">Michael</a>
		</header>

		<main>
			<section class="hero">
				<p class="eyebrow">PERSONAL WEBSITE</p>

				<h1>
					Hi, I'm Michael.
				</h1>

				<p class="intro">
					I write about things I learn, build, and think about.
					Mostly robotics, software, and technology.
				</p>
			</section>

			<section class="notes">
				<h2>Notes</h2>

				{
					notes.length === 0 ? (
						<div class="empty">
							<p>No posts yet.</p>
							<p>I'm just getting started.</p>
						</div>
					) : (
						<ul class="post-list">
							{notes.map((note) => (
								<li>
									<a href={`/notes/${note.id}`}>{note.data.title}</a>

									<p class="post-meta">
										<time datetime={note.data.pubDate.toISOString()}>
											{note.data.pubDate.toLocaleDateString("en-US", {
												year: "numeric",
												month: "long",
												day: "numeric",
											})}
										</time>
									</p>

									{note.data.description && (
										<p class="post-desc">{note.data.description}</p>
									)}
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>

		<footer>
			<p>© 2026 Michael</p>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family:
			-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #222;
		background: #fafafa;
	}

	header {
		max-width: 1000px;
		margin: 0 auto;
		padding: 28px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		font-weight: 700;
		font-size: 18px;
		color: inherit;
		text-decoration: none;
	}

	main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 80px 24px;
	}

	.hero {
		max-width: 680px;
		padding: 60px 0 80px;
	}

	.eyebrow {
		font-size: 12px;
		letter-spacing: 0.12em;
		color: #888;
		margin-bottom: 24px;
	}

	h1 {
		font-size: clamp(48px, 8vw, 80px);
		line-height: 1;
		letter-spacing: -0.04em;
		margin: 0 0 28px;
	}

	.intro {
		font-size: 20px;
		line-height: 1.7;
		color: #666;
	}

	.notes {
		border-top: 1px solid #ddd;
		padding-top: 32px;
	}

	h2 {
		font-size: 20px;
	}

	.empty {
		color: #888;
		line-height: 1.6;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-list li {
		border-top: 1px solid #ddd;
		padding: 16px 0;
	}

	.post-list a {
		color: #111;
		font-size: 17px;
		font-weight: 600;
		text-decoration: none;
	}

	.post-list a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.post-meta {
		font-size: 13px;
		color: #999;
		margin: 4px 0 0;
	}

	.post-desc {
		color: #666;
		line-height: 1.6;
		margin: 6px 0 0;
	}

	footer {
		max-width: 1000px;
		margin: 0 auto;
		padding: 40px 24px;
		color: #999;
		font-size: 13px;
	}
</style>
